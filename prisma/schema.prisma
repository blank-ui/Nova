generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum InquiryStatus {
  NEW
  CONTACTED
  QUALIFIED
  PROPOSAL_SENT
  CONVERTED
  CLOSED
}

enum ProjectStatus {
  PLANNING
  IN_PROGRESS
  REVIEW
  COMPLETED
  ON_HOLD
}

model User {
  id               String        @id @default(cuid())
  email            String        @unique
  name             String
  passwordHash     String?
  role             String        @default("CLIENT")
  emailVerified    Boolean       @default(false)
  emailVerifiedAt  DateTime?
  image            String?
  phone            String?
  dateOfBirth      String?
  discordHandle    String?
  discordId        String?
  twoFactorEnabled Boolean       @default(false)
  banned           Boolean       @default(false)
  banReason        String?
  banExpires       DateTime?
  invitationSentAt DateTime?
  invitationSeenAt DateTime?
  passwordCreatedAt DateTime?
  lastLoginAt      DateTime?
  lastLoginIp      String?
  lastLoginCity    String?
  lastLoginCountry String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  projects         Project[]
  sessions         Session[]
  authSessions          AuthSession[]
  accounts              AuthAccount[]
  twoFactors            AuthTwoFactor[]
  auditEvents           AuditLog[]
  bootstrapClaim        BootstrapClaim?
  appointmentsRequested Appointment[] @relation("AppointmentsRequested")
  appointmentsAssigned  Appointment[] @relation("AppointmentsAssigned")
  invoices              Invoice[]
  sentTeamMessages      TeamMessage[] @relation("SentTeamMessages")
  receivedTeamMessages  TeamMessage[] @relation("ReceivedTeamMessages")
  loginHistories        UserLoginHistory[]
  clientNotesWritten    ClientNote[]  @relation("ClientNotesAuthored")
  clientNotesReceived   ClientNote[]  @relation("ClientNotesTarget")
  @@index([role, createdAt])
  @@index([discordId])
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, expiresAt])
}

model AuthSession {
  id             String   @id @default(cuid())
  token          String   @unique
  userId         String
  expiresAt      DateTime
  ipAddress      String?
  userAgent      String?  @db.Text
  impersonatedBy String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
}

model AuthAccount {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  accessToken           String?   @db.Text
  refreshToken          String?   @db.Text
  idToken               String?   @db.Text
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?   @db.Text
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([providerId, accountId])
  @@index([userId])
}

model AuthVerification {
  id         String   @id @default(cuid())
  identifier String
  value      String   @db.Text
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  @@index([identifier])
}

model AuthTwoFactor {
  id                    String   @id @default(cuid())
  userId                String
  secret                String   @db.Text
  backupCodes           String   @db.Text
  verified              Boolean  @default(true)
  failedVerificationCount Int     @default(0)
  lockedUntil           DateTime?
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([secret(length: 191)])
  @@index([userId])
}

model AuthRateLimit {
  id          String @id @default(cuid())
  key         String @unique
  count       Int
  lastRequest BigInt
}

model BootstrapClaim {
  id        String   @id
  userId    String   @unique
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
}

model Inquiry {
  id        String        @id @default(cuid())
  name      String
  email     String
  phone     String?
  dateOfBirth String?
  company   String?
  service   String
  budget    String?
  message   String        @db.Text
  referenceUrl   String?  @db.Text
  referenceImage String?  @db.Text
  status    InquiryStatus @default(NEW)
  createdAt DateTime      @default(now())
  @@index([status, createdAt])
  @@index([email])
  @@index([createdAt])
}

model Project {
  id          String        @id @default(cuid())
  name        String
  description String?       @db.Text
  status      ProjectStatus @default(PLANNING)
  clientId    String
  paymentStatus String        @default("PAID")
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  client      User          @relation(fields: [clientId], references: [id])
  milestones  Milestone[]
  tasks       Task[]
  messages    Message[]
  files       ProjectFile[]
  invoices    Invoice[]
  @@index([clientId, status])
  @@index([updatedAt])
  @@index([status])
  @@index([paymentStatus])
}

model Milestone {
  id          String   @id @default(cuid())
  projectId   String
  title       String
  description String?  @db.Text
  dueAt       DateTime?
  completedAt DateTime?
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  @@index([projectId, dueAt])
  @@index([projectId, completedAt])
}

model Task {
  id          String   @id @default(cuid())
  projectId   String
  title       String
  completedAt DateTime?
  dueAt       DateTime?
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  @@index([projectId, dueAt])
  @@index([projectId, completedAt])
}

model Message {
  id        String   @id @default(cuid())
  projectId String
  authorId  String
  body      String   @db.Text
  createdAt DateTime @default(now())
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  @@index([projectId, createdAt])
}

model ProjectFile {
  id           String   @id @default(cuid())
  projectId    String
  storageKey   String   @unique
  originalName String
  mimeType     String
  sizeBytes    Int
  createdAt    DateTime @default(now())
  project      Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  @@index([projectId, createdAt])
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  action     String
  entityType String
  entityId   String?
  metadata   Json?
  createdAt  DateTime @default(now())
  actor      User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  @@index([actorId, createdAt])
  @@index([entityType, entityId])
}

model StudioSettings {
  id              String   @id @default("default")
  githubUser      String   @default("blank-ui")
  visibleRepos    String   @db.Text // JSON string array of repo names
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model GalleryItem {
  id          String   @id @default(cuid())
  title       String
  description String?  @db.Text
  imageUrl    String   @db.Text
  category    String   @default("UI/UX")
  repoName    String?
  projectUrl  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  @@index([category, createdAt])
}

model Appointment {
  id              String    @id @default(cuid())
  title           String
  description     String?   @db.Text
  date            DateTime
  duration        Int       @default(30) // Duration in minutes
  status          String    @default("REQUESTED") // REQUESTED, SCHEDULED, COMPLETED, CANCELLED
  meetingLink     String?
  notes           String?   @db.Text
  requestedById   String
  requestedBy     User      @relation("AppointmentsRequested", fields: [requestedById], references: [id], onDelete: Cascade)
  assignedStaffId String?
  assignedStaff   User?     @relation("AppointmentsAssigned", fields: [assignedStaffId], references: [id], onDelete: SetNull)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([status, date])
  @@index([requestedById])
  @@index([assignedStaffId])
}

model Invoice {
  id            String    @id @default(cuid())
  invoiceNumber String    @unique
  projectId     String
  project       Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  clientId      String
  client        User      @relation(fields: [clientId], references: [id], onDelete: Cascade)
  amount        Float     @default(12500.00)
  currency      String    @default("USD")
  status        String    @default("PAID") // PAID, PENDING, DRAFT, SENT
  dueDate       DateTime?
  issuedAt      DateTime  @default(now())
  paidAt        DateTime?
  sentAt        DateTime?
  sentToEmail   String?
  items         Json?
  notes         String?   @db.Text
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([projectId])
  @@index([clientId])
  @@index([status])
  @@index([invoiceNumber])
}

model TeamMessage {
  id          String    @id @default(cuid())
  senderId    String
  recipientId String?   // If null, it is an internal channel message (e.g., general, engineering, finance)
  channel     String?   @default("general") // "general" | "engineering" | "finance" | null (when 1-on-1 direct message)
  body        String    @db.Text
  createdAt   DateTime  @default(now())

  sender    User  @relation("SentTeamMessages", fields: [senderId], references: [id], onDelete: Cascade)
  recipient User? @relation("ReceivedTeamMessages", fields: [recipientId], references: [id], onDelete: Cascade)

  @@index([senderId, recipientId, createdAt])
  @@index([channel, createdAt])
}

model UserLoginHistory {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  ipAddress   String
  city        String?
  country     String?
  countryCode String?
  userAgent   String?  @db.Text
  createdAt   DateTime @default(now())

  @@index([userId, createdAt])
  @@index([countryCode])
}

model ClientNote {
  id         String   @id @default(cuid())
  clientId   String
  client     User     @relation("ClientNotesTarget", fields: [clientId], references: [id], onDelete: Cascade)
  authorId   String
  author     User     @relation("ClientNotesAuthored", fields: [authorId], references: [id], onDelete: Cascade)
  targetDate String   // ISO date string "YYYY-MM-DD"
  note       String   @db.Text
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([clientId, targetDate])
  @@index([authorId])
}

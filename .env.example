# ==============================================================================
# NOVA APPLICATION CONFIGURATION (.env.example)
# Production Domain: https://nova.allskyfares.com
# Operating Entity: All Sky Fares LLC
# ==============================================================================
# Copy this file to .env and configure real values in your secure environment.
# NEVER commit real credentials, passwords, or production secrets to Git.
# ==============================================================================

# Node Environment
NODE_ENV="production"

# Production Canonical Application Base URL
# Must match the exact public origin (e.g. https://nova.allskyfares.com)
APP_URL="https://nova.allskyfares.com"

# Database Configuration (MySQL 8.x on Hostinger)
# Format: mysql://<db_user>:<db_password>@<db_host>:<port>/<db_name>?connection_limit=10&pool_timeout=20
# Note: On Hostinger VPS, db_host is typically 127.0.0.1 or localhost.
# On Hostinger Managed/Cloud, ensure remote access is whitelisted if accessing externally.
DATABASE_URL="mysql://u123456789_nova:YourStrongDbPasswordHere@127.0.0.1:3306/u123456789_nova?connection_limit=10&pool_timeout=20"

# Authentication Secret (Minimum 32 random characters/bytes)
# Required in production. Better Auth will refuse to boot if unset.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET="generate-a-random-secret-at-least-32-characters"

# Hostinger SMTP Transactional Email Delivery
# Used for verification codes, password resets, account setup invitations, and notifications
EMAIL_FROM="Nova <nova@allskyfares.com>"
SMTP_HOST="smtp.hostinger.com"
SMTP_PORT="465"
SMTP_SECURE="true"
SMTP_USER="nova@allskyfares.com"
SMTP_PASS="YourHostingerMailboxPassword"

# Multi-Factor Authentication (TOTP)
ADMIN_MFA_ISSUER="Nova"

# Initial Operator Administrator Bootstrap (One-time usage)
# Set a high-entropy secret and verified admin email during 'npm run auth:bootstrap', then clear.
ADMIN_BOOTSTRAP_SECRET=""
BOOTSTRAP_ADMIN_EMAIL="nova@allskyfares.com"

# Google OAuth Credentials (Optional)
# If provided, enables "Continue with Google" on login/registration.
# Authorized Redirect URI in Google Cloud Console:
# https://nova.allskyfares.com/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Discord Integration (Optional)
# Webhook URL sends real-time inquiry and quote notifications to your Discord server
DISCORD_CLIENT_ID=""
DISCORD_CLIENT_SECRET=""
DISCORD_WEBHOOK_URL=""

# GitHub API Integration (Optional)
# Personal Access Token used to query GitHub repositories in Admin Showcase without strict IP rate limits
GITHUB_TOKEN=""

# Private File Storage (AWS S3 or S3-compatible, e.g. Cloudflare R2 / Hostinger Object Storage)
# Optional: Deferred to client workspace file sharing phase
PRIVATE_STORAGE_BUCKET=""
PRIVATE_STORAGE_REGION="auto"
PRIVATE_STORAGE_ENDPOINT=""
PRIVATE_STORAGE_ACCESS_KEY=""
PRIVATE_STORAGE_SECRET_KEY=""

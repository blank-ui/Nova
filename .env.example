# ==============================================================================
# NOVA APPLICATION CONFIGURATION (.env.example)
# ==============================================================================
# Copy this file to .env and configure values before starting the application.
# Never commit real credentials, passwords, or production secrets to source control.
# ==============================================================================

# Database Configuration (MySQL 8.x)
# Dedicated local development or staging MySQL instance:
# Format: mysql://<user>:<password>@<host>:<port>/<database_name>
DATABASE_URL="mysql://nova_dev_user:change_this_local_password@localhost:3306/nova_dev"

# Application Base URL
APP_URL="http://localhost:3000"

# Authentication Secret (Minimum 32 random characters/bytes)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET="generate-a-random-secret-at-least-32-characters"

# Google OAuth Credentials (Optional in local dev)
# Required only if Google Sign-In is enabled. Obtain from Google Cloud Console.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Transactional Email Service & Hostinger SMTP/IMAP
EMAIL_FROM="Nova <nova@allskyfares.com>"
EMAIL_USER=""
EMAIL_PASS=""
SMTP_HOST="smtp.hostinger.com"
SMTP_PORT="465"
SMTP_SECURE="true"
SMTP_USER=""
SMTP_PASS=""
IMAP_HOST="imap.hostinger.com"
IMAP_PORT="993"
IMAP_SECURE="true"
IMAP_USER=""
IMAP_PASS=""
EMAIL_API_KEY=""


# Operator Administrator Bootstrap (Used ONLY for initial admin promotion)
# Set high-entropy secret and verified account email during 'npm run auth:bootstrap', then clear.
ADMIN_BOOTSTRAP_SECRET=""
BOOTSTRAP_ADMIN_EMAIL=""

# Multi-Factor Authentication (TOTP)
ADMIN_MFA_ISSUER="Nova"

# Private File Storage (AWS S3 or S3-compatible, e.g., Cloudflare R2 / MinIO)
# Deferred to storage phase
PRIVATE_STORAGE_BUCKET=""
PRIVATE_STORAGE_REGION="auto"
PRIVATE_STORAGE_ENDPOINT=""
PRIVATE_STORAGE_ACCESS_KEY=""
PRIVATE_STORAGE_SECRET_KEY=""

# Discord Integration (OAuth & Automated CRM Webhook Alerts)
DISCORD_CLIENT_ID=""
DISCORD_CLIENT_SECRET=""
DISCORD_WEBHOOK_URL=""
